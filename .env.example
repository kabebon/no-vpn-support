# Настройки почтового сервера (SMTP)
# ВАЖНО: Используйте "Пароль приложения" (App Password) для Яндекса/Mail.ru/Google
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=ваша-почта@yandex.ru
SMTP_PASS=ваш-пароль-приложения
SMTP_FROM=ваша-почта@yandex.ru

# Email адрес администратора (куда будут приходить тикеты)
SUPPORT_EMAIL=ваша-почта@yandex.ru

# Имя отправителя
SENDER_NAME="VPN Support"

# --- Настройки Telegram (Опционально) ---
# Токен вашего бота (от @BotFather)
TG_BOT_TOKEN=
# ID чата или ваш личный ID, куда присылать уведомления
TG_CHAT_ID=

# Порт, на котором запустится сервер (оставьте 8080 для docker-compose)
PORT=8080
