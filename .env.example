# Настройки почтового сервера (SMTP)
# Для Resend: SMTP_USER=resend, SMTP_PORT=2465
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_USER=resend
SMTP_PASS=ваш-api-ключ-resend
SMTP_FROM=support@ваш-домен.ru

# Email адрес администратора (куда будут приходить тикеты)
SUPPORT_EMAIL=ваша-почта@example.com

# Имя отправителя (по умолчанию: Поддержка KabebaVPN)
SENDER_NAME="Поддержка KabebaVPN"

# --- Настройки Telegram ---
# Токен вашего бота (от @BotFather)
TG_BOT_TOKEN=
# ID чата или ваш личный ID (получить у @userinfobot)
TG_CHAT_ID=

# Ссылка на личный кабинет (кнопка "В кабинет" в sidebar)
CABINET_URL=https://ваш-кабинет.ru

# Порт, на котором запустится сервер (оставьте 8080 для docker-compose)
PORT=8080
